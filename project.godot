[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="prop"
3d_physics/layer_5="debris"
3d_physics/layer_6="ragdoll"
3d_physics/layer_7="dynamic"
3d_physics/layer_8="pushaway"
3d_physics/layer_9="projectile"
3d_physics/layer_10="hitbox"
3d_physics/layer_11="trigger"
3d_physics/layer_20="editor_pick"

[lux]

story/graph_path="res://stories/example_story.tres"

[physics]

common/physics_ticks_per_second=64
3d/physics_engine="Jolt Physics"
3d/default_gravity=20.32

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
occlusion_culling/use_occlusion_culling=true

[shader_globals]

lod_scale={
"type": "float",
"value": 1.0
}
